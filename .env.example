# Content Hub configuration.
# Copy to .env and edit:  cp .env.example .env
# Real environment variables override anything set here.

# --- Storage -----------------------------------------------------------------
# Where uploaded videos are stored.
# Relative paths resolve against the project folder, so the default below already
# points at the storage drive this project lives on. Leave it alone unless you
# want media somewhere else entirely.
MEDIA_ROOT=media

# Example: put media on a different drive using an absolute path.
# MEDIA_ROOT=/mnt/bigdrive/content-media

# SQLite database file. Relative paths resolve against the project folder.
DB_PATH=content_hub.db

# --- Server ------------------------------------------------------------------
# Loopback only. There is no authentication, so do not expose this to a network.
HOST=127.0.0.1
PORT=8000

# --- Uploads -----------------------------------------------------------------
# Bytes read from the network per write. 1 MiB keeps memory flat on huge files.
UPLOAD_CHUNK_SIZE=1048576

# Largest accepted upload, in bytes. Default 5 GB. Set 0 to disable the limit.
MAX_UPLOAD_BYTES=5368709120
